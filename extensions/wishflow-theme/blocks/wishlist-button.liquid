{%- comment -%}
  WishFlow "Add to wishlist" button for product pages (and featured product sections).
{%- endcomment -%}
{%- liquid
  assign wf_product = block.settings.product
  if wf_product == blank
    assign wf_product = product
  endif
-%}
{%- if wf_product != blank -%}
  <script>
    window.WishFlowBlockConfig = window.WishFlowBlockConfig || {
      root: {{ routes.root_url | json }},
      loginUrl: {{ routes.account_login_url | json }},
      cartUrl: {{ routes.cart_url | json }},
      customerId: {{ customer.id | json }},
      currency: {{ cart.currency.iso_code | json }}
    };
  </script>
  <link rel="stylesheet" href="{{ 'wishflow.css' | asset_url }}" media="all">
  <script src="{{ 'wishflow.js' | asset_url }}" defer></script>
  <div
    class="wishflow-pdp wishflow-pdp--{{ block.settings.alignment }}"
    style="margin-top: {{ block.settings.margin_top }}px; margin-bottom: {{ block.settings.margin_bottom }}px; --wf-pdp-color: {{ block.settings.text_color }}; --wf-pdp-bg: {{ block.settings.bg_color }}; --wf-pdp-border: {{ block.settings.border_color }};"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      class="wishflow-btn wishflow-btn--pdp wishflow-btn--{{ block.settings.style }}{% if block.settings.full_width %} wishflow-btn--full{% endif %}"
      data-wishflow-button
      data-product-id="{{ wf_product.id }}"
      data-product-handle="{{ wf_product.handle }}"
      data-variant-id="{{ wf_product.selected_or_first_available_variant.id }}"
      data-label-add="{{ block.settings.label_add | escape }}"
      data-label-added="{{ block.settings.label_added | escape }}"
      aria-pressed="false"
      aria-label="{{ block.settings.label_add | escape }}"
    >
      <span class="wishflow-icon" aria-hidden="true"></span>
      {%- unless block.settings.style == 'icon' -%}
        <span class="wishflow-label" data-wishflow-label>{{ block.settings.label_add | escape }}</span>
      {%- endunless -%}
    </button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Wishlist button",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "select", "id": "style", "label": "Button style", "default": "outline",
      "options": [
        { "value": "outline", "label": "Outline button" },
        { "value": "solid", "label": "Solid button" },
        { "value": "text", "label": "Icon and text" },
        { "value": "icon", "label": "Icon only" }
      ]
    },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    {
      "type": "select", "id": "alignment", "label": "Alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "label_add", "label": "Button text", "default": "Add to wishlist" },
    { "type": "text", "id": "label_added", "label": "Button text when saved", "default": "In your wishlist" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#121212" },
    { "type": "color", "id": "bg_color", "label": "Solid button background", "default": "#121212" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#121212" },
    { "type": "range", "id": "margin_top", "label": "Space above", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "margin_bottom", "label": "Space below", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 }
  ]
}
{% endschema %}
